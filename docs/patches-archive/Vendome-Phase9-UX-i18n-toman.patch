+.wizard-mode-switch button {
+  display: inline-flex;
+  min-height: 40px;
+  align-items: center;
+  padding: 0 14px;
+  gap: 7px;
+  color: var(--muted-foreground);
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 9px;
+  font-size: 10px;
+  cursor: pointer;
+}
+
+.wizard-mode-switch button.is-active {
+  color: var(--foreground);
+  background: color-mix(in oklch, var(--gold) 10%, var(--card));
+  border-color: color-mix(in oklch, var(--gold) 55%, var(--border));
+}
+
+.checkbox-field {
+  display: flex;
+  min-height: 42px;
+  align-items: center;
+  padding: 8px 11px;
+  gap: 8px;
+  background: var(--background);
+  border: 1px solid var(--border);
+  border-radius: 9px;
+  font-size: 10px;
+}
+
+.wizard-existing-summary {
+  display: flex;
+  min-height: 105px;
+  align-items: center;
+  padding: 18px;
+  gap: 13px;
+  color: var(--success);
+  background: color-mix(in oklch, var(--success) 8%, var(--card));
+  border: 1px solid color-mix(in oklch, var(--success) 25%, var(--border));
+  border-radius: 11px;
+}
+
+.wizard-existing-summary p {
+  margin: 4px 0 0;
+  color: var(--muted-foreground);
+  font-size: 10px;
+}
+
+.wizard-review {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  margin: 0;
+  gap: 1px;
+  overflow: hidden;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+}
+
+.wizard-review > div {
+  display: flex;
+  min-height: 54px;
+  align-items: center;
+  justify-content: space-between;
+  padding: 11px 13px;
+  gap: 12px;
+  background: var(--card);
+  border-bottom: 1px solid var(--border);
+}
+
+.wizard-review dt {
+  color: var(--muted-foreground);
+  font-size: 9px;
+}
+
+.wizard-review dd {
+  margin: 0;
+  font-size: 11px;
+  font-weight: 600;
+  text-align: end;
+}
+
+.wizard-actions {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding-top: 3px;
+  gap: 10px;
+}
+
+.language-button {
+  display: inline-flex;
+  width: auto;
+  min-width: 58px;
+  grid-auto-flow: column;
+  padding: 0 8px;
+  gap: 5px;
+}
+
+.language-button span {
+  font-family: "Vazirmatn", sans-serif;
+  font-size: 9px;
+  font-weight: 700;
+}
+
+.auth-language-button {
+  position: fixed;
+  top: 20px;
+  right: 24px;
+  z-index: 10;
+  display: inline-flex;
+  min-height: 38px;
+  align-items: center;
+  padding: 0 13px;
+  gap: 7px;
+  color: var(--foreground);
+  background: color-mix(in oklch, var(--card) 90%, transparent);
+  border: 1px solid var(--border);
+  border-radius: 9px;
+  box-shadow: var(--shadow-card);
+  font-size: 10px;
+  font-weight: 600;
+  cursor: pointer;
+}
+
+html[data-locale="en"] body,
+html[data-locale="en"] .module-main,
+html[data-locale="en"] .dashboard-main,
+html[data-locale="en"] .sidebar nav,
+html[data-locale="en"] .sidebar-label,
+html[data-locale="en"] .sidebar-footer,
+html[data-locale="en"] .market-rail,
+html[data-locale="en"] .modal-layer,
+html[data-locale="en"] .quick-card,
+html[data-locale="en"] .insights-grid,
+html[data-locale="en"] .auth-form-panel,
+html[data-locale="en"] .auth-brand-content,
+html[data-locale="en"] .toast {
+  direction: ltr;
+}
+
+html[data-locale="en"] .data-table {
+  text-align: left;
+}
+
+html[data-locale="en"] .global-search input {
+  direction: ltr;
+}
+
+html[data-locale="en"] .profile-button,
+html[data-locale="en"] .profile-menu {
+  direction: ltr;
+}
+
+html[data-locale="en"] .quick-card {
+  text-align: left;
+}
+
+html[data-locale="en"] .auth-brand-content {
+  text-align: left;
+}
+
+html[data-locale="en"] .auth-brand-rule {
+  margin-right: auto;
+  margin-left: 0;
+}
+
+html[data-locale="en"] .auth-language-button {
+  right: auto;
+  left: 24px;
+}
+
