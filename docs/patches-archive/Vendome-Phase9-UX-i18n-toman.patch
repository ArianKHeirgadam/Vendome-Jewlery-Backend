+const dynamicTranslations: Array<[RegExp, string]> = [
+  [/^سلام،\s*(.+)$/u, "Hello, $1"],
+  [/^ثبت خرید از\s+(.+)$/u, "Record purchase from $1"],
+  [/^مدل جدید برای\s+(.+)$/u, "New variant for $1"],
+  [/^تصویر\s+(.+)$/u, "$1 image"],
+  [/^تسویه\s+(.+)$/u, "Settle $1"],
+  [/^فاکتور\s+(.+)$/u, "Invoice $1"],
+  [/^سفارش\s+(.+)$/u, "Order $1"],
+  [/^مبلغ قابل پرداخت:\s*(.+)$/u, "Amount due: $1"],
+  [/^(.+)\s+تومان$/u, "$1 toman"],
+  [/^(.+)\s+فاکتور$/u, "$1 invoices"],
+  [/^(.+)\s+محصول$/u, "$1 products"],
+  [/^(.+)\s+مشتری$/u, "$1 customers"],
+  [/^(.+)\s+سفارش$/u, "$1 orders"],
+  [/^(.+)\s+قطعه$/u, "$1 pieces"],
+  [/^(.+)\s+پرداخت$/u, "$1 payments"],
+  [/^موجودی\s+(.+)$/u, "Stock $1"],
+  [/^پیگیری:\s*(.+)$/u, "Follow-up: $1"],
+];
