+@media (max-width: 767px) {
+  .wizard-steps {
+    grid-template-columns: repeat(6, minmax(88px, 1fr));
+    padding-bottom: 8px;
+    overflow-x: auto;
+  }
+
+  .wizard-steps li:not(:last-child)::after {
+    display: none;
+  }
+
+  .wizard-panel {
+    min-height: 300px;
+    padding: 15px;
+  }
+
+  .wizard-review {
+    grid-template-columns: 1fr;
+  }
+
+  .wizard-actions {
+    align-items: stretch;
+  }
+
+  .wizard-actions > button {
+    flex: 1;
+  }
+
+  .language-button {
+    min-width: 36px;
+    padding: 0;
+  }
+
