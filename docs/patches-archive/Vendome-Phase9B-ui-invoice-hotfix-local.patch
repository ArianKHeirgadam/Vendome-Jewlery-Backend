diff --git a/GoldInvoice.Client/src/features/operations/operations-hotfixes.css b/GoldInvoice.Client/src/features/operations/operations-hotfixes.css
new file mode 100644
index 0000000..16c8581
--- /dev/null
+++ b/GoldInvoice.Client/src/features/operations/operations-hotfixes.css
@@ -0,0 +1,79 @@
+/*
+ * Phase 9B UI hardening.
+ * Scoped overrides only: preserve the existing Vendome visual design.
+ */
+
+/* Supplier purchase wizard: keep the modal usable on short/small desktop viewports. */
+.modal-layer:has(.purchase-wizard) {
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.modal-card:has(.purchase-wizard) {
+  max-height: calc(100dvh - 32px);
+}
+
+.modal-card:has(.purchase-wizard) .modal-body {
+  max-height: calc(100dvh - 132px);
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+}
+
+.purchase-wizard,
+.wizard-panel {
+  min-width: 0;
+}
+
+/* Dark-mode contrast: primary actions must not blend into the dark page background. */
+:root[data-theme="dark"] .primary-button {
+  color: #fffdf8;
+  background: color-mix(in oklch, var(--navy-soft) 88%, var(--gold) 12%);
+  border-color: color-mix(in oklch, var(--gold) 30%, var(--border));
+}
+
+:root[data-theme="dark"] .primary-button:hover:not(:disabled) {
+  color: #ffffff;
+  background: color-mix(in oklch, var(--navy-soft) 76%, var(--gold) 24%);
+  border-color: color-mix(in oklch, var(--gold) 48%, var(--border));
+}
+
+:root[data-theme="dark"] .primary-button:focus-visible {
+  outline-color: color-mix(in oklch, var(--gold) 75%, white);
+}
+
+:root[data-theme="dark"] .wizard-steps .is-current button > span {
+  color: #fffdf8;
+  background: color-mix(in oklch, var(--navy-soft) 88%, var(--gold) 12%);
+  border-color: color-mix(in oklch, var(--gold) 35%, var(--border));
+}
+
+@media (max-height: 760px) {
+  .modal-layer:has(.purchase-wizard) {
+    padding-block: 16px;
+    place-items: start center;
+  }
+
+  .modal-card:has(.purchase-wizard) {
+    max-height: calc(100dvh - 32px);
+  }
+
+  .modal-card:has(.purchase-wizard) .modal-body {
+    max-height: calc(100dvh - 118px);
+  }
+
+  .wizard-panel {
+    min-height: 0;
+  }
+}
+
+@media (max-width: 760px) {
+  .wizard-steps {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    row-gap: 12px;
+  }
+
+  .wizard-steps li:not(:last-child)::after {
+    display: none;
+  }
+}
