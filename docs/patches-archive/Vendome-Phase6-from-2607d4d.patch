+        if (nextRetryAt < releasedAt)
+        {
+            throw new ArgumentOutOfRangeException(nameof(nextRetryAt));
+        }
+
+        Status = OutboxMessageStatus.Failed;
+        NextRetryAt = nextRetryAt;
+        LockId = null;
+        LockedUntil = null;
+    }
