+        EnsureLockOwner(lockId, processedAt, requireUnexpiredLock: false);
+        Status = OutboxMessageStatus.Processed;
+        ProcessedAt = processedAt;
+        NextRetryAt = null;
+        LastError = null;
+        LockId = null;
+        LockedUntil = null;
+    }
+
+    public void MarkFailed(
