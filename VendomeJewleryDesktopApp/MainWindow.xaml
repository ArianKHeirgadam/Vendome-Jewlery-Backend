<Window x:Class="VendomeJewleryDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Vendome Jewelry"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F1E8"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">
    <Grid>
        <wv2:WebView2 x:Name="DashboardWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <Border x:Name="StartupPanel"
                Panel.ZIndex="10"
                Background="#0C1B33">
            <Grid>
                <StackPanel Width="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.FontFamily="Segoe UI">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Georgia"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Foreground="#C7A55B"
                               Text="VENDOME" />
                    <Border Width="74"
                            Height="1"
                            Margin="0,18,0,26"
                            HorizontalAlignment="Center"
                            Background="#C7A55B" />
                    <TextBlock x:Name="StartupStatusText"
                               HorizontalAlignment="Center"
                               FlowDirection="RightToLeft"
                               FontSize="18"
                               Foreground="White"
                               Text="در حال آماده‌سازی برنامه..."
                               TextAlignment="Center" />
                    <TextBlock x:Name="StartupDetailsText"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FlowDirection="RightToLeft"
                               FontSize="13"
                               Foreground="#B9C0CB"
                               Text="رابط React و نشست امن Windows در حال راه‌اندازی هستند."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="RetryButton"
                            Width="126"
                            Height="38"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Click="RetryButton_Click"
                            Content="تلاش دوباره"
                            FlowDirection="RightToLeft"
                            FontSize="14"
                            Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
