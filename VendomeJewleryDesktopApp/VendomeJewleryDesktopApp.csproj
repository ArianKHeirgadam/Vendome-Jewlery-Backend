<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>Vendome Jewelry</ApplicationTitle>
    <ReactClientRoot>$(MSBuildProjectDirectory)\..\GoldInvoice.Client\</ReactClientRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ReactClientRoot)node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <Target Name="BuildReactClient" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(ReactClientRoot)node_modules')">
    <Exec WorkingDirectory="$(ReactClientRoot)" Command="npm run build" />
  </Target>

  <Target Name="CopyReactClientToOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup><ReactDistFiles Include="$(ReactClientRoot)dist\**\*" /></ItemGroup>
    <Error Condition="'@(ReactDistFiles)' == ''" Text="The React production output was not found. Run 'npm --prefix GoldInvoice.Client run build' and build again." />
    <Copy SourceFiles="@(ReactDistFiles)" DestinationFiles="@(ReactDistFiles->'$(OutDir)ClientApp\dist\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyReactClientToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup><ReactPublishFiles Include="$(ReactClientRoot)dist\**\*" /></ItemGroup>
    <Error Condition="'@(ReactPublishFiles)' == ''" Text="The React production output was not found. Run 'npm --prefix GoldInvoice.Client run build' and publish again." />
    <Copy SourceFiles="@(ReactPublishFiles)" DestinationFiles="@(ReactPublishFiles->'$(PublishDir)ClientApp\dist\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
