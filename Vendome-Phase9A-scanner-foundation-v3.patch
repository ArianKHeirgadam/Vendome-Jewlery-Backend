new file mode 100644
index 0000000..f5ad5fa
--- /dev/null
+++ b/GoldInvoice.Client/src/features/operations/InventoryScanner.tsx
@@ -0,0 +1,136 @@
+import { Search } from "lucide-react";
+import { type FormEvent, useCallback, useMemo, useState } from "react";
+import { useHidScanner } from "../../platform/useHidScanner";
+import { useOperations } from "./OperationsContext";
+import { OperationalApiError } from "./operationsApi";
+import type { InventoryUnit } from "./operations.types";
+import { StatusBadge } from "./PagePrimitives";
+
+function scannerMessage(error: unknown): string {
+  if (error instanceof OperationalApiError && error.status === 404) {
+    return "قطعه‌ای با این بارکد، سریال یا شناسه پیدا نشد.";
+  }
+
+  return error instanceof Error ? error.message : "جست‌وجوی قطعه کامل نشد.";
+}
+
+function formatWeight(value?: number | null): string {
+  if (value == null) return "—";
+  return `${value.toLocaleString("fa-IR", { maximumFractionDigits: 3 })} گرم`;
+}
+
+export function InventoryScanner() {
+  const { data, request } = useOperations();
+  const [identifier, setIdentifier] = useState("");
+  const [unit, setUnit] = useState<InventoryUnit | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const product = useMemo(
+    () => data.products.find((item) => item.id === unit?.productId),
+    [data.products, unit?.productId],
+  );
+  const variant = useMemo(
+    () => product?.variants.find((item) => item.id === unit?.productVariantId),
+    [product, unit?.productVariantId],
+  );
+  const warehouse = useMemo(
+    () => data.warehouses.find((item) => item.id === unit?.warehouseId),
+    [data.warehouses, unit?.warehouseId],
+  );
+
+  const lookup = useCallback(async (rawIdentifier: string) => {
+    const normalized = rawIdentifier.trim();
+    if (normalized.length < 3 || normalized.length > 128) {
+      setUnit(null);
+      setError("شناسه اسکن‌شده باید بین ۳ تا ۱۲۸ کاراکتر باشد.");
+      return;
+    }
+
+    setIdentifier(normalized);
+    setLoading(true);
+    setError(null);
+
+    try {
+      const found = await request<InventoryUnit>(
+        `/api/v1/inventory/units/lookup?identifier=${encodeURIComponent(normalized)}`,
+      );
+      setUnit(found);
+    } catch (lookupError) {
+      setUnit(null);
+      setError(scannerMessage(lookupError));
+    } finally {
+      setLoading(false);
+    }
+  }, [request]);
+
+  useHidScanner({
+    enabled: !loading,
+    onScan: (code) => { void lookup(code); },
+  });
+
+  const submit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    void lookup(identifier);
+  };
+
+  return (
+    <section className="lux-card" aria-labelledby="inventory-scanner-title">
+      <div className="section-heading">
+        <div>
+          <h2 id="inventory-scanner-title">اسکن QR / بارکد قطعه</h2>
+          <p>اسکنر USB در حالت Keyboard/HID را اسکن کن؛ یا شناسه را دستی وارد کن.</p>
+        </div>
+        <Search size={22} aria-hidden="true" />
+      </div>
+
+      <form className="entity-form entity-form--page" onSubmit={submit}>
+        <label className="form-field form-field--wide">
+          <span>بارکد، شماره سریال یا شناسه قطعه</span>
+          <input
+            value={identifier}
+            onChange={(event) => setIdentifier(event.target.value)}
+            dir="ltr"
+            autoComplete="off"
+            spellCheck={false}
+            maxLength={128}
+            placeholder="مثال: VND-U-8H4V7K2M"
+          />
+        </label>
+        <button className="secondary-button" type="submit" disabled={loading}>
+          <Search size={16} />
+          {loading ? "در حال جست‌وجو…" : "جست‌وجوی قطعه"}
+        </button>
+      </form>
+
+      {error && <div className="inline-error" role="alert">{error}</div>}
+
+      {unit && (
+        <div className="table-scroll">
+          <table className="data-table">
+            <thead>
+              <tr>
+                <th>محصول / مدل</th><th>بارکد / سریال</th><th>انبار</th>
+                <th>عیار</th><th>وزن کل</th><th>وزن خالص</th><th>وضعیت</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr>
+                <td>
+                  <strong>{product?.name || "محصول ثبت‌شده"}</strong>
+                  <small>{variant ? `${variant.name} · ${variant.sku}` : unit.productVariantId}</small>
+                </td>
+                <td className="numeric-cell">{unit.barcode || unit.serialNumber || unit.id}</td>
+                <td>{warehouse?.name || unit.warehouseId}</td>
+                <td>{unit.karat ?? variant?.goldDetail?.karat ?? "—"}</td>
+                <td>{formatWeight(unit.actualGrossWeight ?? variant?.goldDetail?.grossWeight)}</td>
+                <td>{formatWeight(unit.actualNetGoldWeight ?? variant?.goldDetail?.netGoldWeight)}</td>
+                <td><StatusBadge status={unit.status} /></td>
+              </tr>
+            </tbody>
+          </table>
+        </div>
+      )}
+    </section>
+  );
+}
