{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "GoldInvoice": ""
  },
  "Api": {
    "AllowedCorsOrigins": [],
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "CorrelationId": {
    "HeaderName": "X-Correlation-ID",
    "MaxLength": 64
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false
  },
  "MarketPrices": {
    "PollIntervalMinutes": 5,
    "ProviderTimeoutSeconds": 10,
    "RetryCount": 3,
    "RetryBaseDelayMilliseconds": 250,
    "MaximumQuoteAgeMinutes": 30,
    "MaximumFutureClockSkewSeconds": 60
  },
  "Payments": {
    "ProviderTimeoutSeconds": 15,
    "MaximumGatewayConfigurationsPerProvider": 5
  },
  "Invoicing": {
    "SequenceSeries": "DEFAULT",
    "SequencePrefix": "INV"
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalMilliseconds": 1000,
    "LockDurationSeconds": 60,
    "HeartbeatIntervalSeconds": 20,
    "MaximumAttempts": 5,
    "RetryBaseDelaySeconds": 5,
    "MaximumRetryDelaySeconds": 300
  },
  "Jwt": {
    "Issuer": "VendomeJewelry.Api",
    "Audience": "VendomeJewelry.Clients",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 10,
    "MfaEnrollmentTokenLifetimeMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "Security": {
    "PasswordRequiredLength": 12,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "SessionLifetimeDays": 30,
    "RefreshTokenLifetimeDays": 14,
    "RecoveryCodeCount": 10,
    "AuthenticatorIssuer": "Vendome Jewelry",
    "BootstrapOwner": {
      "Enabled": false
    }
  },
  "RateLimiting": {
    "Authentication": {
      "Login": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      },
      "Refresh": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "Mfa": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      }
    },
    "PaymentCallbacks": {
      "Rule": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
